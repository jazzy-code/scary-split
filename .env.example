# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
DIRECT_URL=

BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

NEXT_PUBLIC_BETTER_AUTH_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos (Resend). EMAIL_FROM es opcional; por defecto usa hello@jazzycode.com
RESEND_API_KEY=
EMAIL_FROM="Scary Split <hello@jazzycode.com>"

# SMTP de respaldo (Hostinger), se usa solo si Resend falla o agota su cuota diaria
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER="hello@jazzycode.com"
SMTP_PASSWORD=
